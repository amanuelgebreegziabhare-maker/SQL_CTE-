-- Step 1: Find the total Sales per Customers

WITH CTE_Total_Sales AS
(
SELECT 
	CustomerID,
	SUM(Sales) AS Total_Sales
FROM Sales.Orders
GROUP BY CustomerID
)

--Main Query
SELECT
	c.CustomerID,
	c.FirstName,
	c.LastName,
	s.Total_Sales
FROM Sales.Customers AS c
LEFT JOIN CTE_Total_Sales AS s
ON c.CustomerID = s.CustomerID
